<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Field Notes — Interactive Navigation</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600;9..144,700&family=Space+Grotesk:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --paper:#F6F1E4;
    --ink:#1B1B18;
    --pine:#12302B;
    --pine-deep:#0C231F;
    --gold:#C9A227;
    --gold-soft:#E4C55B;
    --cream:#FAF7EE;
    --nav-h:76px;
  }

  *{box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{
    margin:0;
    font-family:'Space Grotesk', sans-serif;
    background:var(--paper);
    color:var(--ink);
    -webkit-font-smoothing:antialiased;
  }

  /* ---------- NAV ---------- */
  .nav{
    position:fixed;
    top:0; left:0; right:0;
    height:var(--nav-h);
    z-index:1000;
    display:flex;
    align-items:center;
    justify-content:space-between;
    padding:0 clamp(20px, 5vw, 56px);
    background:transparent;
    border-bottom:1px solid transparent;
    transition:background-color 0.5s ease, border-color 0.5s ease, box-shadow 0.5s ease, backdrop-filter 0.5s ease, padding 0.4s ease;
  }

  .nav.scrolled{
    background:rgba(246,241,228,0.86);
    backdrop-filter:blur(14px) saturate(140%);
    -webkit-backdrop-filter:blur(14px) saturate(140%);
    border-bottom:1px solid rgba(27,27,24,0.08);
    box-shadow:0 8px 30px -12px rgba(12,35,31,0.25);
    height:64px;
  }

  .nav-logo{
    font-family:'Fraunces', serif;
    font-weight:600;
    font-size:1.35rem;
    letter-spacing:0.01em;
    color:var(--cream);
    text-decoration:none;
    display:flex;
    align-items:baseline;
    gap:8px;
    transition:color 0.5s ease;
  }
  .nav-logo span{
    font-family:'Space Grotesk', sans-serif;
    font-size:0.65rem;
    font-weight:500;
    letter-spacing:0.18em;
    text-transform:uppercase;
    color:var(--gold-soft);
    transition:color 0.5s ease;
  }
  .nav.scrolled .nav-logo{ color:var(--pine-deep); }
  .nav.scrolled .nav-logo span{ color:#8a7420; }

  .nav-links{
    list-style:none;
    display:flex;
    gap:clamp(18px, 3vw, 40px);
    margin:0;
    padding:0;
  }

  .nav-links a{
    position:relative;
    text-decoration:none;
    color:rgba(250,247,238,0.88);
    font-size:0.92rem;
    font-weight:500;
    letter-spacing:0.01em;
    padding:8px 2px;
    transition:color 0.35s ease;
  }
  .nav.scrolled .nav-links a{ color:rgba(27,27,24,0.72); }

  /* underline that draws from the center on hover */
  .nav-links a::after{
    content:"";
    position:absolute;
    left:50%;
    bottom:2px;
    width:0%;
    height:2px;
    background:var(--gold);
    transform:translateX(-50%);
    transition:width 0.32s cubic-bezier(.5,0,.2,1);
  }
  .nav-links a:hover,
  .nav-links a:focus-visible{
    color:var(--gold-soft);
  }
  .nav.scrolled .nav-links a:hover,
  .nav.scrolled .nav-links a:focus-visible{
    color:var(--pine);
  }
  .nav-links a:hover::after,
  .nav-links a:focus-visible::after{
    width:100%;
  }
  .nav-links a.active::after{ width:100%; }
  .nav-links a.active{ color:var(--gold-soft); }
  .nav.scrolled .nav-links a.active{ color:var(--pine); }

  .nav-links a:focus-visible{
    outline:2px solid var(--gold);
    outline-offset:4px;
    border-radius:2px;
  }

  .nav-cta{
    border:1px solid rgba(250,247,238,0.5);
    color:var(--cream);
    background:transparent;
    padding:9px 18px;
    border-radius:999px;
    font-family:inherit;
    font-size:0.85rem;
    font-weight:500;
    cursor:pointer;
    transition:all 0.35s ease;
  }
  .nav-cta:hover{
    background:var(--gold);
    border-color:var(--gold);
    color:var(--pine-deep);
  }
  .nav.scrolled .nav-cta{
    border-color:rgba(27,27,24,0.25);
    color:var(--pine-deep);
  }
  .nav.scrolled .nav-cta:hover{
    background:var(--pine);
    border-color:var(--pine);
    color:var(--cream);
  }

  /* mobile toggle */
  .nav-toggle{
    display:none;
    flex-direction:column;
    gap:5px;
    background:none;
    border:none;
    cursor:pointer;
    padding:6px;
  }
  .nav-toggle span{
    width:22px; height:2px;
    background:var(--cream);
    transition:background 0.4s ease;
  }
  .nav.scrolled .nav-toggle span{ background:var(--pine-deep); }

  @media (max-width:760px){
    .nav-links{
      position:fixed;
      top:var(--nav-h);
      left:0; right:0;
      flex-direction:column;
      background:var(--pine-deep);
      padding:20px clamp(20px,6vw,40px) 28px;
      gap:6px;
      transform:translateY(-130%);
      opacity:0;
      transition:transform 0.4s ease, opacity 0.3s ease;
    }
    .nav.scrolled .nav-links{ background:var(--cream); }
    .nav-links.open{ transform:translateY(0); opacity:1; }
    .nav-links a{ display:block; padding:12px 4px; color:var(--cream); }
    .nav.scrolled .nav-links a{ color:var(--pine-deep); }
    .nav-cta{ display:none; }
    .nav-toggle{ display:flex; }
  }

  /* ---------- DEMO PAGE CONTENT ---------- */
  .hero{
    height:100vh;
    display:flex;
    flex-direction:column;
    align-items:center;
    justify-content:center;
    text-align:center;
    background:
      radial-gradient(circle at 20% 20%, rgba(201,162,39,0.18), transparent 45%),
      linear-gradient(180deg, var(--pine) 0%, var(--pine-deep) 100%);
    color:var(--cream);
    padding:0 24px;
  }
  .hero .eyebrow{
    font-size:0.75rem;
    letter-spacing:0.25em;
    text-transform:uppercase;
    color:var(--gold-soft);
    margin-bottom:18px;
  }
  .hero h1{
    font-family:'Fraunces', serif;
    font-weight:600;
    font-size:clamp(2.4rem, 6vw, 4.6rem);
    line-height:1.05;
    max-width:16ch;
    margin:0 0 20px;
  }
  .hero p{
    max-width:46ch;
    color:rgba(250,247,238,0.75);
    font-size:1.05rem;
    line-height:1.6;
    margin:0 0 8px;
  }
  .hero .hint{
    margin-top:56px;
    font-size:0.8rem;
    letter-spacing:0.08em;
    color:rgba(250,247,238,0.5);
    text-transform:uppercase;
  }

  section.page{
    min-height:100vh;
    padding:120px clamp(24px,8vw,120px);
    max-width:900px;
    margin:0 auto;
    display:flex;
    flex-direction:column;
    justify-content:center;
  }
  section.page .num{
    font-family:'Fraunces', serif;
    font-size:0.85rem;
    color:var(--gold);
    letter-spacing:0.1em;
    margin-bottom:10px;
  }
  section.page h2{
    font-family:'Fraunces', serif;
    font-size:clamp(1.8rem, 4vw, 2.8rem);
    margin:0 0 18px;
    color:var(--pine-deep);
  }
  section.page p{
    font-size:1.05rem;
    line-height:1.75;
    color:#3a3a35;
    max-width:64ch;
  }
  section.page:nth-of-type(even){ background:var(--cream); }

  footer{
    padding:60px 24px;
    text-align:center;
    background:var(--pine-deep);
    color:rgba(250,247,238,0.6);
    font-size:0.85rem;
  }
</style>
</head>
<body>

  <nav class="nav" id="siteNav">
    <a href="#home" class="nav-logo">Field Notes <span>Est. 2026</span></a>

    <ul class="nav-links" id="navLinks">
      <li><a href="#home" class="active">Home</a></li>
      <li><a href="#work">Work</a></li>
      <li><a href="#about">About</a></li>
      <li><a href="#journal">Journal</a></li>
      <li><a href="#contact">Contact</a></li>
    </ul>

    <button class="nav-cta">Get in touch</button>

    <button class="nav-toggle" id="navToggle" aria-label="Toggle menu" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
  </nav>

  <header class="hero" id="home">
    <p class="eyebrow">Scroll to see it change</p>
    <h1>A navigation menu that reacts to you</h1>
    <p>Transparent over the hero, it turns to solid warm paper the moment you scroll — and every link draws its own underline the moment your cursor lands on it.</p>
    <p class="hint">↓ keep scrolling ↓</p>
  </header>

  <section class="page" id="work">
    <div class="num">01 — Work</div>
    <h2>Built for every page</h2>
    <p>Drop this markup, CSS and script into the top of any HTML page and the nav stays fixed to the viewport, tracks scroll position, and keeps the current section highlighted as you move through the content below.</p>
  </section>

  <section class="page" id="about">
    <div class="num">02 — About</div>
    <h2>Two states, one component</h2>
    <p>At the top of the page the bar sits transparent against the hero. Past 60 pixels of scroll it crossfades to a frosted paper surface with a soft shadow, so it always stays legible against whatever's behind it.</p>
  </section>

  <section class="page" id="journal">
    <div class="num">03 — Journal</div>
    <h2>Hover for detail</h2>
    <p>Each link carries a thin gold underline that grows outward from its center on hover or keyboard focus, rather than a flat color swap — a small, deliberate signature rather than a stock effect.</p>
  </section>

  <section class="page" id="contact">
    <div class="num">04 — Contact</div>
    <h2>Ready to use as-is</h2>
    <p>Everything lives in this single HTML file: markup, styling and behavior. Copy it, rename the links and logo, and it's ready to sit at the top of any site.</p>
  </section>

  <footer>Field Notes — a self-contained navigation demo, single HTML file.</footer>

<script>
  const nav = document.getElementById('siteNav');
  const toggle = document.getElementById('navToggle');
  const links = document.getElementById('navLinks');
  const navLinks = document.querySelectorAll('.nav-links a');
  const sections = document.querySelectorAll('section.page, header.hero');

  // Change nav style on scroll
  function onScroll(){
    if(window.scrollY > 60){
      nav.classList.add('scrolled');
    } else {
      nav.classList.remove('scrolled');
    }

    // highlight the link matching the section currently in view
    let currentId = sections[0].id;
    const probe = window.scrollY + window.innerHeight * 0.35;
    sections.forEach(sec => {
      if(probe >= sec.offsetTop){
        currentId = sec.id;
      }
    });
    navLinks.forEach(a => {
      a.classList.toggle('active', a.getAttribute('href') === '#' + currentId);
    });
  }
  document.addEventListener('scroll', onScroll, { passive:true });
  onScroll();

  // Mobile menu toggle
  toggle.addEventListener('click', () => {
    const isOpen = links.classList.toggle('open');
    toggle.setAttribute('aria-expanded', isOpen);
  });

  // Close mobile menu after choosing a link
  navLinks.forEach(a => a.addEventListener('click', () => {
    links.classList.remove('open');
    toggle.setAttribute('aria-expanded', 'false');
  }));
</script>

</body>
</html>
